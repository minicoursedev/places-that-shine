---
interface Props { kind?: 'work' | 'designer' }
const { kind = 'work' } = Astro.props;
const id = `${kind}-share`;
const isWork = kind === 'work';
---
<dialog id={`${id}-dialog`} class="dlg work-share-dialog" aria-labelledby={`${id}-title`} aria-describedby={`${id}-description`} data-share-kind={kind}>
  <div class="dlg-head"><h2 id={`${id}-title`}>{isWork ? '分享這件作品' : '分享設計師'}</h2><button type="button" class="dlg-close" aria-label="關閉分享">×</button></div>
  <div class="dlg-body">
    <div class="work-share-preview">{isWork && <img id={`${id}-image`} alt="" hidden />}<p id={`${id}-designer`}></p></div>
    <p id={`${id}-description`} class="work-share-description">{isWork ? '分享作品連結，朋友點開就能看作品、逛攤位。' : '分享這位設計師在本館的攤位。'}</p>
    <div class="work-share-platforms"><a id={`${id}-facebook`} class="btn" target="_blank" rel="noopener noreferrer">分享到 Facebook</a><a id={`${id}-threads`} class="btn" target="_blank" rel="noopener noreferrer">分享到 Threads</a></div>
    <div class="work-share-actions"><button id={`${id}-copy`} type="button" class="btn btn-primary">{isWork ? '複製作品連結' : '複製連結'}</button><button id={`${id}-native`} type="button" class="btn" hidden>更多分享方式</button></div>
    <p id={`${id}-status`} class="muted work-share-status" role="status" aria-live="polite"></p>
    <img id={`${id}-qr`} class="work-share-qr" width="192" height="192" alt={isWork ? '作品連結 QR Code' : '設計師連結 QR Code'} hidden />
    <p id={`${id}-qr-status`} class="muted work-share-status" role="status"></p>
    <a id={`${id}-url`} class="work-share-url" target="_blank" rel="noopener noreferrer"></a>
  </div>
</dialog>
<script is:inline type="module" src="/designers/js/work-share.js?v=20261114-share-channels"></script>
