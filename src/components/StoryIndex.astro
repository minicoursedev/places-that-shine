---
import SiteLayout from '../layouts/SiteLayout.astro';
import { storyEventPath } from '../lib/story-events';
import { storyCategories, storyEntries, type StoryCategory } from '../lib/stories';

interface Props {
  category?: StoryCategory;
}

const { category } = Astro.props;
const title = '努力發著光';
const description = '收錄店家、設計師與舞台之外，仍在努力發光的人、事與物。';
const pageTitle = category ? `${storyCategories[category]}｜${title}` : title;
const entries = category ? storyEntries.filter(entry => entry.category === category) : storyEntries;
---

<SiteLayout title={pageTitle} description={description}>
  <section class="story-index" aria-labelledby="story-title">
    <header class="index-heading" id="story-front-matter">
      <h1 id="story-title">{title}</h1>
      <p>{description}</p>
    </header>

    <section id="story-contents" aria-label="收錄篇目">
      <nav class="index-filters" aria-label="依類別瀏覽">
        <a href="/stories/" aria-current={category === undefined ? 'page' : undefined}>全部</a>
        {Object.entries(storyCategories).map(([slug, label]) => (
          <a href={`/stories/${slug}/`} aria-current={category === slug ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <div class="story-list" id="story-list">
        {entries.map(entry => (
          <article class="index-entry" id={entry.id} aria-labelledby={`${entry.id}-title`}>
            <p class="index-kind">
              {entry.category !== 'media' && <span class="index-category">{storyCategories[entry.category]}</span>}
              {entry.type}
              {entry.category === 'people' && entry.party && <span class="index-party">{entry.party}</span>}
            </p>
            <div class="index-copy">
              <h2 id={`${entry.id}-title`}>{entry.title}</h2>
              {entry.category === 'media' && (
                <p class="index-founding">
                  <span>成立時間</span>
                  {entry.founding?.description ?? '尚待查證'}
                  {entry.founding?.sources.map(({ label, href }) => (
                    <a href={href} aria-label={`${entry.title}成立時間資料來源 ${label}`}>{label}</a>
                  ))}
                </p>
              )}
              <p>{entry.description}</p>
              {entry.category === 'people' && entry.movement && (
                <p class="index-movement">
                  <span>社運脈絡</span>
                  {entry.movement.description}
                  <a href={entry.movement.href} aria-label={`${entry.title}的社運資料來源`}>資料來源</a>
                </p>
              )}
              {entry.category === 'events' ? (
                <a href={storyEventPath(entry.id)} aria-label={`查看專頁 ${entry.title}`}>查看專頁</a>
              ) : (
                <a href={entry.href} aria-label={`${entry.source ?? '前往原站'} ${entry.title}`}>{entry.source ?? '前往原站'}</a>
              )}
            </div>
          </article>
        ))}
        {entries.length === 0 && <p class="index-empty">尚未收錄。</p>}
      </div>
    </section>
  </section>
</SiteLayout>

<style>
  .story-index {
    width: min(100% - 2 * var(--gutter), 56rem);
    min-height: 68vh;
    margin-inline: auto;
    padding-block: clamp(2.75rem, 7vw, 6.25rem) clamp(3.25rem, 7vw, 6rem);
  }

  .index-heading { margin-block-end: clamp(1.5rem, 3.8vw, 3rem); }
  .index-heading h1 {
    margin: 0 0 .7rem;
    font: 800 clamp(2.35rem, 6.4vw, 5rem)/1.21 var(--serif);
    letter-spacing: .04em;
  }
  .index-heading p {
    max-width: 33em;
    margin: 0;
    color: var(--muted);
    font: 550 1rem/1.85 var(--serif);
  }

  .index-filters { display: flex; flex-wrap: wrap; gap: clamp(.3rem, 1.8vw, 1rem); }
  .index-filters a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: .4rem .5rem .55rem;
    border-block-end: 2px solid transparent;
    color: var(--muted);
    font: 700 .9375rem/1.5 var(--sans);
    text-decoration: none;
  }
  .index-filters a:hover { color: var(--ink); }
  .index-filters a[aria-current='page'] { border-block-end-color: var(--accent); color: var(--ink); }

  .story-list { border-block-start: 1px solid var(--line); }
  .index-entry {
    display: grid;
    grid-template-columns: minmax(6.5rem, .25fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    padding-block: clamp(1.35rem, 3vw, 2.45rem);
    border-block-end: 1px solid var(--line);
  }
  .index-kind {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    align-self: start;
    gap: .25rem .55rem;
    margin: .35rem 0 0;
    color: var(--muted);
    font: 650 .875rem/1.5 var(--sans);
  }
  .index-category { color: var(--accent); font: 800 1rem/1.5 var(--serif); }
  .index-party { flex-basis: 100%; }
  .index-copy { max-width: 39rem; }
  .index-entry h2 {
    margin: 0;
    font: 800 clamp(1.35rem, 2.9vw, 2rem)/1.4 var(--serif);
    letter-spacing: .018em;
  }
  .index-entry:target h2 { color: var(--accent); }
  .index-copy p {
    margin: .45rem 0 .65rem;
    color: var(--muted);
    font: 550 1rem/1.8 var(--serif);
    overflow-wrap: anywhere;
  }
  .index-founding span,
  .index-movement span {
    margin-inline-end: .4rem;
    color: var(--ink);
    font-weight: 700;
  }
  .index-founding a,
  .index-movement a { margin-inline-start: .3rem; }
  .index-copy a {
    color: var(--accent);
    font: 700 .875rem/1.5 var(--sans);
    text-decoration-thickness: 1px;
    text-underline-offset: .23em;
  }
  .index-copy a:hover { color: var(--ink); }
  .index-empty { margin: 0; padding-block: 1.8rem; color: var(--muted); }

  @media (max-width: 550px) {
    .story-index { width: min(100% - 2rem, 56rem); padding-block-start: 2.4rem; }
    .index-entry { grid-template-columns: minmax(0, 1fr); gap: .45rem; }
    .index-kind { margin-block-start: 0; }
    .index-party {
      flex-basis: auto;
      padding-inline-start: .55rem;
      border-inline-start: 1px solid var(--line);
    }
  }
</style>
