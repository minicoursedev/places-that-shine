---
import SiteLayout from '../layouts/SiteLayout.astro';

const entries = [
  { href: '/stores/', title: '發光的店家', description: '找一間想走進去的店', cover: 'store.webp', width: 600, height: 400 },
  { href: '/designers/periods/', title: '發光的設計師', description: '逛逛設計師與他們的作品', cover: 'designer.webp', width: 600, height: 400 },
  { href: '/stage/', title: '發光的舞台', description: '聽一首歌，看一場演出', cover: 'stage.webp', width: 320, height: 180 },
];
---
<SiteLayout title="發光的地方" description="在發光的地方，逛設計師的作品、看舞台演出。">
  <script is:inline slot="head">
    const oldLocation = /^#(stores|designers|stage)(?:\/([a-z0-9-]+)(?:\/([a-z0-9-]+))?)?$/.exec(location.hash);
    if (oldLocation) {
      const [, section, detail, work] = oldLocation;
      let target = `/${section}/`;
      if (section === 'designers' && detail) {
        if (!work && ['walk', 'list', 'map'].includes(detail)) {
          if (detail !== 'walk') target += `#/${detail}`;
        } else {
          target += `${detail}/`;
          if (work) target += `works/${work}/`;
        }
      }
      location.replace(target);
    }
  </script>
  <section id="home" class="hero" aria-labelledby="home-title">
    <img class="hero-image" src="/media/tainan-evening.webp" width="1774" height="887" alt="" fetchpriority="high" />
    <div class="hero-inner page-width">
      <span class="hero-mark" aria-hidden="true">✦</span>
      <h1 id="home-title">發光的地方</h1>
      <p class="hero-quote">我相信光<br />是為了巷弄間的歡騰，不是為了墳前的孤寂</p>
      <a class="hero-action" href="#explore">開始探索 <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section id="explore" class="explore page-width" aria-labelledby="explore-title">
    <div class="section-heading"><h2 id="explore-title">尋光去</h2></div>
    <div class="entry-grid">
      {entries.map(({ href, title, description, cover, width, height }) => (
        <a class="entry" href={href}>
          <div class="entry-photo"><img src={`/media/${cover}`} width={width} height={height} alt="" /></div>
          <div class="entry-info">
            <div><h3>{title}</h3><p>{description}</p></div>
            <span class="entry-arrow" aria-hidden="true">↗</span>
          </div>
        </a>
      ))}
    </div>
    <a class="entry story-entry" href="/stories/">
      <span class="story-cover" aria-hidden="true">✦</span>
      <div class="entry-info">
        <div><h3>努力發著光</h3><p>翻開故事書，遇見更多發光的人、事、物。</p></div>
        <span class="entry-arrow" aria-hidden="true">↗</span>
      </div>
    </a>
  </section>
</SiteLayout>

<style>
  .story-entry {
    flex-direction: row;
    align-items: center;
    margin-top: clamp(1rem, 2.2vw, 1.8rem);
  }

  .story-cover {
    display: grid;
    place-items: center;
    flex: 0 0 2.75rem;
    height: 3.6rem;
    margin: .85rem 0 .85rem 1.15rem;
    border: 1px solid #413644;
    border-left-width: 4px;
    border-radius: 2px 4px 4px 2px;
    box-shadow: 2px 1px #e6cda7;
    color: #edc081;
    background: #30293b;
    font-size: 1.2rem;
  }
</style>
