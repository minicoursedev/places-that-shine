---
import SiteLayout from '../layouts/SiteLayout.astro';
import { designerHallRoot } from '../../public/designers/js/routes.js';

const title = '發光的地方';
const description = '在發光的地方，逛設計師的作品、看舞台演出。';
const quoteLead = '我相信光';
const quoteLine = '是為了巷弄間的歡騰，不是為了墳前的孤寂';
const actionLabel = '開始探索';
const exploreTitle = '尋光去';
const storyTitle = '努力發著光';
const storyDescription = '更多值得認識的人、事與物。';
const shareImage = new URL('/media/places-that-shine-og.webp', Astro.site);
const shareImageAlt = `${title}。 ${quoteLead}，${quoteLine}`;

const entries = [
  { href: '/stores/', title: '發光的店家', description: '找一間想走進去的店', cover: 'store.webp', coverAvif: 'store.avif', width: 600, height: 400 },
  { href: '/designers/', title: '發光的設計師', description: '逛逛設計師與他們的作品', cover: 'designer.webp', width: 600, height: 400 },
  { href: '/stage/', title: '發光的舞台', description: '聽一首歌，看一場演出', cover: 'stage.webp', coverAvif: 'stage.avif', width: 320, height: 180 },
];
const fontText = [
  title, quoteLead, quoteLine, actionLabel, exploreTitle, storyTitle, storyDescription, '↓↗',
  ...entries.flatMap(({ title, description }) => [title, description]),
].join('');
---
<SiteLayout title={title} description={description} analytics={false} fontText={fontText}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
  </Fragment>
  <script slot="head" define:vars={{ designerHallPath: designerHallRoot('O') }}>
    const oldLocation = /^#(stores|designers|stage)(?:\/([a-z0-9-]+)(?:\/([a-z0-9-]+))?)?$/.exec(location.hash);
    if (oldLocation) {
      const [, section, detail, work] = oldLocation;
      let target = `/${section}/`;
      if (section === 'designers' && detail) {
        if (!work && ['walk', 'list', 'map'].includes(detail)) {
          target = designerHallPath;
          if (detail !== 'walk') target += `#/${detail}`;
        } else {
          target += `${detail}/`;
          if (work) target += `works/${work}/`;
        }
      }
      location.replace(target);
    } else {
      const analytics = document.createElement('script');
      analytics.src = '/assets/analytics.js?v=20261019-content-group';
      document.head.appendChild(analytics);
    }
  </script>
  <section id="home" class="hero" aria-labelledby="home-title">
    <picture class="hero-picture">
      <!-- The portrait crop keeps the same 65% focal point as the mobile object-position. -->
      <source
        type="image/avif"
        media="(max-width: 720px) and (max-width: 32.5rem)"
        srcset="/media/tainan-evening-portrait.avif"
      />
      <!-- With object-fit: cover, the visible frame can be narrower than the scaled 2:1 photo. -->
      <source
        type="image/avif"
        srcset="/media/tainan-evening-1000.avif 1000w, /media/tainan-evening-1400.avif 1400w, /media/tainan-evening-1774.avif 1774w"
        sizes="(max-width: 720px) 62rem, (max-width: 960px) 60rem, 100vw"
      />
      <img class="hero-image" src="/media/tainan-evening.webp" width="1774" height="887" alt="" fetchpriority="high" />
    </picture>
    <div class="hero-inner page-width">
      <span class="hero-mark" aria-hidden="true">✦</span>
      <h1 id="home-title">{title}</h1>
      <p class="hero-quote">{quoteLead}<br />{quoteLine}</p>
      <a class="hero-action" href="#explore">{actionLabel} <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section id="explore" class="explore page-width" aria-labelledby="explore-title">
    <div class="section-heading"><h2 id="explore-title">{exploreTitle}</h2></div>
    <div class="entry-grid">
      {entries.map(({ href, title, description, cover, coverAvif, width, height }) => {
        const Photo = coverAvif ? 'picture' : 'div';
        return (
          <a class="entry" href={href}>
            <Photo class="entry-photo">
              {coverAvif && <source type="image/avif" srcset={`/media/${coverAvif}`} />}
              <img src={`/media/${cover}`} width={width} height={height} alt="" />
            </Photo>
            <div class="entry-info">
              <div><h3>{title}</h3><p>{description}</p></div>
              <span class="entry-arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        );
      })}
    </div>
    <a class="entry story-entry" href="/stories/">
      <span class="story-mark" aria-hidden="true">✦</span>
      <div class="entry-info">
        <div><h3>{storyTitle}</h3><p>{storyDescription}</p></div>
        <span class="entry-arrow" aria-hidden="true">↗</span>
      </div>
    </a>
  </section>
</SiteLayout>

<style>
  .hero-picture { position: absolute; inset: 0; }

  .story-entry {
    flex-direction: row;
    align-items: center;
    margin-top: clamp(1rem, 2.2vw, 1.8rem);
  }

  .story-mark {
    display: grid;
    place-items: center;
    flex: 0 0 2.75rem;
    height: 2.75rem;
    margin: .85rem 0 .85rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--accent);
    font-size: 1.2rem;
  }
</style>
