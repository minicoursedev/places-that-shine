---
import StoreDirectory from '../../../../components/StoreDirectory.astro';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { storeEvents, storeEventPath } from '../../../../lib/store-events.js';

export function getStaticPaths() {
  return storeEvents.map(event => ({ params: { id: event.id }, props: { event } }));
}

const { event } = Astro.props;
const title = `${event.name}｜發光的店家`;
const description = `在「發光的店家」查看「${event.name}」的參與店家、分組與地圖位置。`;
const canonical = new URL(storeEventPath(event.id), Astro.site);
const shareImage = new URL('og.png', canonical);
---

<SiteLayout title={title} description={description} active="stores" appendSiteName={false}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="發光的地方" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage.href} />
    <meta name="twitter:image:alt" content={title} />
  </Fragment>
  <StoreDirectory event={event} />
</SiteLayout>
