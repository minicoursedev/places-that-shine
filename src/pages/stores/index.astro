---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { designerWorks } from '../../lib/oshen-designers';
import { designerWorkSharePath } from '../../../public/designers/js/work-links.js';
import '../../styles/stores.css';

const title = '發光的店家';
const description = '發光的店家（我們的洋流地圖）整理台灣各地的小店與生活服務，可搜尋店家並查看到訪資訊與地圖位置。';
const shareImage = new URL('/media/shining-stores-og-shadow-50.jpg', Astro.site);
const shareImageAlt = '發光的店家。我相信光，是為了巷弄間的歡騰，不是為了墳前的孤寂。巷弄夜景與台灣夜間光點示意。';
const workPreviews = designerWorks.flatMap(({ designer, work }) => {
  const booth = designer.booth.hallBooths.find(({ aisle }) => aisle[0] !== 'A');
  if (!booth || work.id === 'yang-liu-avatar') return [];
  return [{
    designerName: designer.name,
    label: work.name.trim() || `${designer.name}的作品`,
    href: designerWorkSharePath(designer.id, work.id, booth.aisle[0]),
    image: work.cover,
    width: work.width,
    height: work.height,
  }];
});
---

<SiteLayout title={`${title}｜我們的洋流地圖`} description={description} active="stores">
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL('/stores/', Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
  </Fragment>
  <section class="stores-directory directory page-width" aria-labelledby="stores-title">
    <div class="directory-header">
      <a class="back-link" href="/#explore"><span aria-hidden="true">←</span> 回探索首頁</a>
      <h1 id="stores-title">{title}</h1>
    </div>
    <div id="stores-content" aria-label="店家目錄" data-work-previews={JSON.stringify(workPreviews)}><p role="status">正在載入店家資料…</p></div>
    <dialog id="store-share-dialog" class="store-share-dialog" aria-labelledby="store-share-title" aria-describedby="store-share-name">
      <h2 id="store-share-title">分享店家</h2>
      <p id="store-share-name"></p>
      <img id="store-share-qr" class="store-share-qr" width="192" height="192" alt="店家連結 QR Code" hidden />
      <p id="store-share-qr-status" class="store-share-status" role="status"></p>
      <a id="store-share-url" class="store-share-url" target="_blank" rel="noopener"></a>
      <div class="store-share-actions">
        <button id="store-share-copy" class="store-action" type="button" autofocus>複製店家連結</button>
        <form method="dialog"><button class="store-action" type="submit">關閉</button></form>
      </div>
      <p id="store-share-status" class="store-share-status" role="status"></p>
    </dialog>
    <dialog id="store-photo-viewer" class="store-photo-viewer" aria-label="全螢幕店家照片">
      <div class="store-photo-track" aria-label="店家照片"></div>
      <button class="store-photo-control store-photo-close" type="button" aria-label="關閉照片" autofocus>×</button>
      <button class="store-photo-control store-photo-previous" type="button" aria-label="上一張照片" data-photo-previous>‹</button>
      <button class="store-photo-control store-photo-next" type="button" aria-label="下一張照片" data-photo-next>›</button>
    </dialog>
    <noscript><p>請開啟 JavaScript 以在本站瀏覽目錄。</p></noscript>
  </section>
</SiteLayout>

<script>
  import { mountStores } from '../../features/stores.js';

  const directory = document.querySelector<HTMLElement>('#stores-content');
  if (directory) void mountStores(directory, JSON.parse(directory.dataset.workPreviews || '[]'));
</script>
