---
import StoreDirectory from '../../../../components/StoreDirectory.astro';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { categories, stores, storeCategoryPath, storePath } from '../../../../lib/oshen-stores';
import { serializeStructuredData } from '../../../../../public/designers/js/profile-seo.js';

interface Props { category: string }

export function getStaticPaths() {
  return categories.map(category => ({ params: { category }, props: { category } }));
}

const { category } = Astro.props;
const compareText = new Intl.Collator('zh-Hant-TW').compare;
const categoryStores = stores.filter(store => store.category === category)
  .sort((a, b) => compareText(a.name, b.name));
const title = `${category}｜我們的洋流地圖`;
const description = `查看洋流地圖收錄的${category}，瀏覽店家地址、資訊與地圖，規劃前往路線。`;
const canonical = new URL(storeCategoryPath(category), Astro.site);
const directoryUrl = new URL('/stores/', Astro.site);
const shareImage = new URL('/media/shining-stores-og-shadow-50.webp', Astro.site);
const shareImageAlt = '發光的店家。我相信光，是為了巷弄間的歡騰，不是為了墳前的孤寂。巷弄夜景與台灣夜間光點示意。';
const listId = `${canonical.href}#stores`;
const breadcrumbId = `${canonical.href}#breadcrumb`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage', '@id': `${canonical.href}#webpage`,
      url: canonical.href, name: title, description, inLanguage: 'zh-Hant-TW',
      mainEntity: { '@id': listId }, breadcrumb: { '@id': breadcrumbId },
    },
    {
      '@type': 'ItemList', '@id': listId,
      name: category, numberOfItems: categoryStores.length,
      itemListElement: categoryStores.map((store, index) => ({
        '@type': 'ListItem', position: index + 1,
        item: { '@id': new URL(storePath(store.id), Astro.site).href, name: store.name },
      })),
    },
    {
      '@type': 'BreadcrumbList', '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '發光的店家', item: directoryUrl.href },
        { '@type': 'ListItem', position: 2, name: category, item: canonical.href },
      ],
    },
  ],
};
---

<SiteLayout title={title} description={description} active="stores">
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="發光的地方" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage.href} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <script is:inline type="application/ld+json" set:html={serializeStructuredData(structuredData)} />
  </Fragment>
  <StoreDirectory category={category} />
</SiteLayout>
