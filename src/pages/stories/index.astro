---
import SiteLayout from '../../layouts/SiteLayout.astro';

const title = '努力發著光';
const description = '收錄店家、設計師與舞台之外，仍在努力發光的人、事與物。';
const categories = ['全部', '人', '事', '物'];
const entries = [
  {
    id: 'democracy-at-4am',
    category: '事',
    type: '歷史事件',
    title: '太陽花學運',
    source: '在凌晨4點的民主',
    description: '透過時間軸、照片、影片與報導，記錄 2014 年太陽花學運的經過與現場聲音。',
    href: 'https://4am-tw.maylogger.com/tw/',
  },
  {
    id: 'taiwan1947',
    category: '物',
    type: '線上筆記',
    title: '二二八台灣史補課筆記（2026）',
    description: '由 @gratitude.drops 整理二二八事件、白色恐怖與台灣民主化的公開資料，收錄附有來源的歷史編年、事件地圖與互動式學習內容。',
    href: 'https://taiwan1947.org/',
  },
  {
    id: 'national-human-rights-museum',
    category: '物',
    type: '場館',
    title: '國家人權博物館',
    description: '國家人權博物館保存白色恐怖景美紀念園區與白色恐怖綠島紀念園區，透過展覽、導覽與教育活動，讓公眾認識臺灣的人權歷史。',
    href: 'https://www.nhrm.gov.tw/',
  },
];
---

<SiteLayout title={title} description={description}>
  <section class="story-index" aria-labelledby="story-title">
    <header class="index-heading" id="story-front-matter">
      <h1 id="story-title">{title}</h1>
      <p>{description}</p>
    </header>

    <section id="story-contents" aria-label="收錄篇目">
      <div class="index-filters" role="group" aria-label="依類別篩選" data-story-filters hidden>
        {categories.map(category => (
          <button type="button" value={category} aria-pressed={category === '全部'} aria-controls="story-list">{category}</button>
        ))}
      </div>
      <p class="visually-hidden" data-story-status role="status"></p>
      <div class="story-list" id="story-list">
        {entries.map(entry => (
          <article class="index-entry" id={entry.id} aria-labelledby={`${entry.id}-title`} data-story-category={entry.category}>
            <p class="index-kind"><span>{entry.category}</span> {entry.type}</p>
            <div class="index-copy">
              <h2 id={`${entry.id}-title`}>{entry.title}</h2>
              <p>{entry.description}</p>
              <a href={entry.href} aria-label={`前往原站 ${entry.source ?? entry.title}`}>{entry.source ?? '前往原站'}</a>
            </div>
          </article>
        ))}
        <p class="index-empty" data-story-empty hidden>尚未收錄。</p>
      </div>
    </section>
  </section>
</SiteLayout>

<script>
  const controls = document.querySelector<HTMLElement>('[data-story-filters]');
  const empty = document.querySelector<HTMLElement>('[data-story-empty]');
  const status = document.querySelector<HTMLElement>('[data-story-status]');

  if (controls && empty && status) {
    const buttons = Array.from(controls.querySelectorAll('button'));
    const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-story-category]'));

    const showCategory = (category: string) => {
      let visibleCount = 0;
      for (const entry of entries) {
        entry.hidden = category !== '全部' && entry.dataset.storyCategory !== category;
        if (!entry.hidden) visibleCount++;
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.value === category));
      }
      empty.hidden = visibleCount > 0;
      status.textContent = visibleCount > 0 ? `顯示 ${visibleCount} 筆收錄。` : empty.textContent;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => showCategory(button.value));
    }

    window.addEventListener('hashchange', () => {
      const target = entries.find(entry => `#${entry.id}` === window.location.hash);
      if (target?.hidden) {
        showCategory('全部');
        target.scrollIntoView();
      }
    });

    controls.hidden = false;
  }
</script>

<style>
  .story-index {
    width: min(100% - 2 * var(--gutter), 56rem);
    min-height: 68vh;
    margin-inline: auto;
    padding-block: clamp(2.75rem, 7vw, 6.25rem) clamp(3.25rem, 7vw, 6rem);
  }

  .index-heading { margin-block-end: clamp(1.5rem, 3.8vw, 3rem); }
  .index-heading h1 {
    margin: 0 0 .7rem;
    font: 800 clamp(2.35rem, 6.4vw, 5rem)/1.21 var(--serif);
    letter-spacing: .04em;
  }
  .index-heading p {
    max-width: 33em;
    margin: 0;
    color: var(--muted);
    font: 550 1rem/1.85 var(--serif);
  }

  .index-filters { display: flex; flex-wrap: wrap; gap: clamp(.3rem, 1.8vw, 1rem); }
  .index-filters button {
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: .4rem .5rem .55rem;
    border: 0;
    border-block-end: 2px solid transparent;
    color: var(--muted);
    background: transparent;
    font: 700 .9375rem/1.5 var(--sans);
    cursor: pointer;
  }
  .index-filters button:hover { color: var(--ink); }
  .index-filters button[aria-pressed='true'] { border-block-end-color: var(--accent); color: var(--ink); }

  .story-list { border-block-start: 1px solid var(--line); }
  .index-entry {
    display: grid;
    grid-template-columns: minmax(6.5rem, .25fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    padding-block: clamp(1.35rem, 3vw, 2.45rem);
    border-block-end: 1px solid var(--line);
  }
  .index-kind {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    align-self: start;
    gap: .25rem .55rem;
    margin: .35rem 0 0;
    color: var(--muted);
    font: 650 .875rem/1.5 var(--sans);
  }
  .index-kind span { color: var(--accent); font: 800 1rem/1.5 var(--serif); }
  .index-copy { max-width: 39rem; }
  .index-entry h2 {
    margin: 0;
    font: 800 clamp(1.35rem, 2.9vw, 2rem)/1.4 var(--serif);
    letter-spacing: .018em;
  }
  .index-entry:target h2 { color: var(--accent); }
  .index-copy p {
    margin: .45rem 0 .65rem;
    color: var(--muted);
    font: 550 1rem/1.8 var(--serif);
    overflow-wrap: anywhere;
  }
  .index-copy a {
    color: var(--accent);
    font: 700 .875rem/1.5 var(--sans);
    text-decoration-thickness: 1px;
    text-underline-offset: .23em;
  }
  .index-copy a:hover { color: var(--ink); }
  .index-empty { margin: 0; padding-block: 1.8rem; color: var(--muted); }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 550px) {
    .story-index { width: min(100% - 2rem, 56rem); padding-block-start: 2.4rem; }
    .index-entry { grid-template-columns: minmax(0, 1fr); gap: .45rem; }
    .index-kind { margin-block-start: 0; }
  }
</style>
