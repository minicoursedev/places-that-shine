---
import SiteLayout from '../../layouts/SiteLayout.astro';

const milestones = [
  {
    date: '2026-11-17',
    title: '洋流設計師首次超過 100 位',
    description: '14:23 更新後，名錄收錄 101 位設計師。',
  },
  {
    date: '2026-11-14',
    title: '「發光的地方」接續洋流地圖',
    description: '把店家、設計師和舞台放在新首頁，從同一個地方出發。',
  },
  {
    date: '2026-11-04',
    title: '洋流設計師首次超過 50 位',
    description: '00:06 更新後，名錄收錄 51 位設計師。',
  },
  {
    date: '2026-10-27',
    title: '加入洋流舞台',
    description: '在站上收錄創作者的演出影片，並加入連續播放。',
  },
  {
    date: '2026-10-26',
    title: '洋流設計師首次超過 10 位',
    description: '09:10 更新後，名錄收錄 11 位設計師。',
  },
  {
    date: '2026-10-25',
    title: '洋流設計師展館加入主站',
    description: '把設計師名錄發展成可以逛攤位、看作品的線上展館。',
  },
  {
    date: '2026-10-24',
    title: '加入洋流設計師',
    description: '建立設計師名錄，整理設計師的標誌與社群連結。',
  },
  {
    date: '2026-10-19',
    title: '開始製作「我們的洋流地圖」',
    description: '第一版從台南店家出發，可以在地圖上找店家、按類別篩選，也能開啟導航。',
  },
];
---

<SiteLayout title="開發歷程" description="從台南的洋流店家地圖，到發光的地方，記錄網站一路加入的功能。">
  <section class="directory page-width" aria-labelledby="history-title">
    <div class="directory-header">
      <a class="back-link" href="/"><span aria-hidden="true">←</span> 回首頁</a>
      <h1 id="history-title">開發歷程</h1>
    </div>
    <ol class="milestones" role="list">
      {milestones.map(({ date, title, description }) => (
        <li>
          <time datetime={date}>{date}</time>
          <div>
            <h2>{title}</h2>
            <p>{description}</p>
          </div>
        </li>
      ))}
    </ol>
    <section class="thanks" aria-labelledby="thanks-title">
      <h2 id="thanks-title">特別感謝</h2>
      <p>感謝証頡（@sorosora）在 Threads <a href="https://www.threads.com/@sorosora/post/DgPGFYakiez">分享改善網站使用體驗的建議</a>。</p>
    </section>
  </section>
</SiteLayout>

<style>
  .milestones {
    max-width: 48rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .milestones li {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .milestones time {
    align-self: start;
    padding-top: .15rem;
    color: var(--accent);
    font-size: .9rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .thanks {
    max-width: 48rem;
    margin-block-start: 2rem;
  }

  .milestones h2, .thanks h2 {
    margin: 0 0 .3rem;
    font: 800 clamp(1.1rem, 2vw, 1.4rem)/1.45 var(--serif);
  }

  .milestones p, .thanks p {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .thanks a {
    color: var(--accent);
    text-underline-offset: .2em;
  }

  @media (max-width: 560px) {
    .milestones li {
      grid-template-columns: minmax(0, 1fr);
      gap: .35rem;
    }

    .milestones time { padding-top: 0; }
  }
</style>
