---
import { catalogue } from '../lib/oshen-stage';
import { stageBase, oshenStagePath, publicHallId, stageHallPath, stagePageMetadata, stageVideoPath } from '../../public/puma_oshen_wave/stage/routes.js';
import { designerHallRoot } from '../../public/designers/js/routes.js';
import PrivacyLink from '../components/PrivacyLink.astro';
import StageHallOpening from '../components/StageHallOpening.astro';
import { stageSceneFor } from '../lib/stage-opening';
interface Props { hallId?: string; videoId?: string; legacyRoot?: boolean }
const { hallId, videoId, legacyRoot } = Astro.props;
const video = catalogue.stages.find(stage => stage.id === videoId);
const hall = catalogue.halls.find(hall => hall.id === hallId);
const scene = video ? undefined : stageSceneFor(hallId || publicHallId);
const members = video ? [video] : hall ? catalogue.stages.filter(stage => stage.hallId === hall.id) : catalogue.stages;
const sceneCount = hall && hall.id !== publicHallId ? members.length : scene?.videos.length;
const { title, description, path } = stagePageMetadata({ stage: video, hall });
const canonical = new URL(path, Astro.site).href;
const legacy = Astro.url.pathname.startsWith('/puma_oshen_wave/stage/');
---
<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#f82970">
<meta name="referrer" content="strict-origin-when-cross-origin">
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<link rel="icon" href="data:,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=IBM+Plex+Mono:wght@500;600&display=swap">
<link rel="stylesheet" href="/puma_oshen_wave/designer/css/market.css">
<link rel="stylesheet" href="/puma_oshen_wave/stage/stage.css?v=20261104-songs-notice">
<link rel="stylesheet" href="/puma_oshen_wave/designer/css/floating-nav.css?v=20261101">
<script is:inline defer src="/assets/analytics.js?v=20261019-content-group"></script>
</head>
<body>
<div class="app">
  <details class="floating-nav" id="floating-nav">
    <summary class="floating-nav-toggle" aria-label="導覽選單"><span aria-hidden="true">☰</span> 選單</summary>
    <nav class="bar" aria-label="導覽選單">
    <a class="plaque" href={oshenStagePath} aria-label="洋流舞台首頁">洋流舞台</a>
    <div class="modes" role="group" aria-label="舞台瀏覽方式">
      <button type="button" data-mode="walk" aria-pressed="true">逛舞台</button>
      <button type="button" data-mode="list" aria-pressed="false">影片列表</button>
      <button type="button" data-mode="map" aria-pressed="false">舞台地圖</button>
    </div>
    <div class="stage-links"><a class="link-btn" href={designerHallRoot('O')}>洋流設計師</a><a class="link-btn" href={legacy ? '/puma_oshen_wave/' : stageBase}>{legacy ? '返回地圖' : '分館總覽'}</a></div>
    </nav>
  </details>
  <main class="stage" id="stage-walk" hidden={!scene} data-stage-opening={scene ? '' : undefined} data-stage-entry={scene?.entryStageIds && JSON.stringify(scene.entryStageIds)}>
    {scene && <StageHallOpening scene={scene} />}
    <canvas id="walk-canvas" tabindex="0" aria-label="洋流舞台：按住拖著小人走，點舞台觀看影片"></canvas>
    <button type="button" class="where" id="btn-where"><b id="where-hall">{scene?.aisle.hallName || '公共舞台'}</b><span id="where-aisle">{scene && `${scene.aisle.code} 走道`}</span><span class="where-switch">看地圖</span></button>
    <div class="status"><span class="tag" id="status-count" role="status">{sceneCount ? `已造訪 0 / ${sceneCount} 座舞台` : '影片準備中'}</span></div>
    <p class="hint" id="hint"><span class="hint-desktop">按住拖著小人走，點影片觀看，點名牌看作者社群。電腦也可以用方向鍵。</span><span class="hint-mobile">拖曳移動；點影片觀看，點名牌看社群。</span></p>
    <p class="stage-message" id="stage-message" role="status" hidden></p>
    <div class="dock">
      <button type="button" class="btn btn-primary" id="btn-watch" disabled={!scene?.videos.length}>{scene?.videos.length ? '觀看影片' : '靠近舞台看影片'}</button>
      <div class="hall-controls">
        <button type="button" class="btn" id="btn-next" disabled={!scene || catalogue.halls.length < 2}>下一個館別</button>
        <label class="hall-picker"><select id="hall-select" aria-label="選擇舞台館別" disabled={!scene}>{scene && catalogue.halls.map(item => <option value={item.id} selected={item.id === scene.aisle.hall}>{item.name}</option>)}</select></label>
      </div>
      <button type="button" class="btn" id="btn-continuous" disabled={!scene?.videos.length}>連續播放</button>
    </div>
  </main>
  <main class="list-mode" id="stage-list" hidden={!!scene}>
    <div class="stage-page"><h1 id="list-title">{video?.title || hall?.name || '洋流舞台'}</h1>
      <label class="stage-search">找一部影片<input id="video-search" type="search" placeholder="搜尋影片、創作者" autocomplete="off"></label>
      <p id="list-count" role="status"></p><div class="video-grid" id="video-list">{members.map(stage => <article class="video-card"><a class="video-poster" href={stageVideoPath(stage.id)}>{stage.video.poster && <img src={stage.video.poster} alt="" loading="lazy" />}</a><h2>{stage.title}</h2><p class="muted creator-meta"><a class="creator-name" href={stageHallPath(stage.hallId)}>{stage.creator}</a></p>{stage.description && <p>{stage.description}</p>}<a class="btn btn-primary" href={stageVideoPath(stage.id)}>觀看影片</a>{video && <a class="btn" href={stage.video.url} target="_blank" rel="noopener noreferrer">到原網站觀看</a>}</article>)}</div>
    </div>
  </main>
  <main class="map-mode" id="stage-map" hidden><div class="stage-page"><h1 id="map-title">舞台地圖</h1><p>選一座舞台，走過去看影片。</p><div id="stage-plan"></div></div></main>
  <footer class="app-footer">
    <small class="footer-full">© 2026 發光的地方｜影片及相關內容權利歸原創作者或原權利人所有。</small>
    <details class="footer-details"><summary>© 2026 發光的地方・版權資訊</summary><small>影片及相關內容權利歸原創作者或原權利人所有。</small></details>
    <PrivacyLink compact />
  </footer>
  <div class="toast" id="toast" role="status" popover="manual"></div>
</div>
<dialog id="video-dialog" class="dlg video-dialog" aria-labelledby="video-title">
  <div class="dlg-head"><h2 id="video-title"></h2><button type="button" class="dlg-close" aria-label="關閉影片">×</button></div>
  <div class="dlg-body">
    <p id="continuous-status" class="continuous-status" role="status" hidden></p>
    <div id="video-player" class="video-player"></div>
    <p><button type="button" id="video-creator" class="creator-name"></button></p><p id="video-description"></p>
    <p class="muted" id="video-help" role="status"></p>
    <div class="video-actions"><a id="video-source" class="btn" target="_blank" rel="noopener noreferrer">到原網站觀看</a><button type="button" class="btn" id="copy-stage">複製舞台連結</button></div>
    <p id="share-status" class="muted" role="status"></p>
  </div>
</dialog>
<dialog id="creator-dialog" class="dlg creator-dialog" aria-labelledby="creator-title">
  <div class="dlg-head"><h2 id="creator-title"></h2><button type="button" class="dlg-close" aria-label="關閉作者資訊">×</button></div>
  <div class="dlg-body">
    <p>追蹤作者的最新作品</p>
    <nav id="creator-socials" class="creator-socials" aria-label="作者社群連結"></nav>
    <p id="creator-empty" class="muted" hidden>作者尚未提供社群連結。</p>
  </div>
</dialog>
{legacyRoot && <dialog id="songs-notice" class="songs-notice" aria-labelledby="songs-notice-title" aria-describedby="songs-notice-intro" tabindex="-1" autofocus closedby="none">
  <div class="songs-notice-head">
    <span class="songs-notice-badge">洋流舞台公告</span>
  </div>
  <a class="songs-notice-link" href="https://puma.taipei/songs">
    <span class="songs-notice-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><path d="M13 23V9l14-3v14M13 13l14-3" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><ellipse cx="8.5" cy="24" rx="4.5" ry="3.5" fill="currentColor"/><ellipse cx="22.5" cy="21" rx="4.5" ry="3.5" fill="currentColor"/></svg></span>
    <p id="songs-notice-intro" class="songs-notice-intro">請轉至 <strong>沈伯洋</strong></p>
    <h2 id="songs-notice-title">台北順起來<span class="songs-notice-subtitle">・市民共創歌曲</span></h2>
    <span class="songs-notice-action">前往 <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <span class="songs-notice-url">puma.taipei/songs</span>
  </a>
  <footer class="songs-notice-footer"><small><PrivacyLink /></small></footer>
</dialog>}
<script is:inline type="module" src="/puma_oshen_wave/stage/app.js?v=20261125-stage-halls"></script>
{legacyRoot && <script is:inline>
  const songsNotice = document.getElementById('songs-notice');
  if (songsNotice && !location.hash && !location.search) {
    songsNotice.addEventListener('cancel', event => event.preventDefault());
    songsNotice.addEventListener('keydown', event => {
      if (event.key === 'Escape') event.preventDefault();
    });
    songsNotice.showModal();
    songsNotice.focus({ preventScroll: true });
  }
</script>}
</body>
</html>

<style>
  .songs-notice-footer { padding: 0 1rem 1rem; text-align: center; }
</style>
