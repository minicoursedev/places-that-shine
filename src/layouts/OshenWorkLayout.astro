---
import WorkShareDialog from '../components/WorkShareDialog.astro';
import PrivacyLink from '../components/PrivacyLink.astro';
import { designerWorks, designerPath } from '../lib/oshen-designers';
import { workInHall } from '../../public/designers/js/products.js';
import { designerWorkPath, designerWorkSharePath } from '../../public/designers/js/work-links.js';
import { designerHallRoot, designerSharePath } from '../../public/designers/js/routes.js';
import { serializeStructuredData } from '../../public/designers/js/profile-seo.js';
interface Props { designerId: string; workId: string; shareHall?: string }
const entry = designerWorks.find(({ designer, work }) => designer.id === Astro.props.designerId && work.id === Astro.props.workId)!;
const { designer, work } = entry;
const shareTitle = `${designer.name} 設計師`;
const workImage = new URL(work.cover, Astro.site);
// Older entries encode their catalogue number in the work ID or the media filename.
const idNumber = work.id.startsWith(designer.id + '-') && work.id.slice(designer.id.length + 1).match(/^\d+$/)?.[0];
const mediaNumber = workImage.pathname.match(/\/(\d+)\.[^/]+$/)?.[1];
const workTitle = work.title?.trim() || `作品 ${work.number || idNumber || mediaNumber || work.id}`;
const titlePrefix = `${designer.name}-${workTitle}|發光的地方|`;
const description = work.caption?.trim() || designer.store.description;
const label = work.name || `${designer.name}的作品`;
const canonical = new URL(designerWorkPath(designer.id, work.id), Astro.site).href;
const shareUrl = Astro.props.shareHall
  ? new URL(designerWorkSharePath(designer.id, work.id, Astro.props.shareHall), Astro.site).href
  : canonical;
const halls = designer.booth.hallBooths.filter(({ aisle }) => workInHall(work, aisle[0])).map(({ aisle, hall }) => ({
  code: aisle[0],
  name: hall,
  authorLabel: hall.replace(/館$/, '').replace(/設計師$/, '') + '設計師',
  pageTitle: titlePrefix + hall,
  marketPath: designerHallRoot(aisle[0]),
  boothPath: designerSharePath(designer.id, aisle[0]),
  sharePath: designerWorkSharePath(designer.id, work.id, aisle[0]),
}));
const firstHall = halls.find(hall => hall.code === Astro.props.shareHall) || halls[0];
const title = firstHall.pageTitle;
const structuredData = {
  '@context': 'https://schema.org', '@type': 'WebPage', url: canonical, name: title, inLanguage: 'zh-Hant-TW',
  ...(description ? { description } : {}),
  primaryImageOfPage: { '@type': 'ImageObject', contentUrl: workImage.href, name: label, ...(work.caption ? { caption: work.caption } : {}) },
  isPartOf: { '@type': 'WebPage', url: new URL(designerPath(designer.id), Astro.site).href, name: designer.name },
};
---
<!doctype html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8" />
  <script is:inline defer src="/assets/analytics.js?v=20261019-content-group"></script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#f82970" />
  <link rel="icon" href="data:," />
  {description && <meta name="description" content={description} />}
  <meta property="og:type" content="website" />
  <meta property="og:url" content={shareUrl} />
  <meta property="og:site_name" content="發光的地方" />
  <meta property="og:locale" content="zh_TW" />
  <meta property="og:title" content={shareTitle} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:image" content={workImage} />
  <meta property="og:image:alt" content={label} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={shareTitle} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={workImage} />
  <meta name="twitter:image:alt" content={label} />
  <script is:inline type="application/ld+json" set:html={serializeStructuredData(structuredData)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" />
  <link rel="stylesheet" href="/designers/css/market.css" />
  <link rel="stylesheet" href="/designers/css/booth.css?v=20261123-webp" />
  <link rel="stylesheet" href="/designers/css/work.css?v=20261114-share-channels" />
</head>
<body class="work-page">
  <header class="work-header">
    <h1 class="work-title" id="work-title">{designer.name}－{workTitle}</h1>
    <a class="work-close" data-work-booth href={firstHall.boothPath} aria-label={`關閉作品，回到${designer.name}`} title="回到設計師攤位"><span aria-hidden="true">×</span></a>
  </header>
  <main class="work-main">
    <nav class="work-breadcrumbs" aria-label="麵包屑導覽"><a data-work-hall href={firstHall.marketPath}>{firstHall.name}</a><span aria-hidden="true">›</span><a data-work-booth href={firstHall.boothPath}>{designer.name}</a><span aria-hidden="true">›</span><span aria-current="page">作品</span></nav>
    <article class="work-grid" aria-labelledby="work-title">
      <figure class="work-figure">
        <div class="work-media">
          {work.video ? <video controls playsinline preload="metadata" poster={work.cover} src={work.video} aria-label={label}></video> : <img src={work.cover} alt={label} loading="eager" fetchpriority="high" decoding="async" />}
        </div>
        {work.caption && <figcaption class="work-caption">{work.caption}</figcaption>}
      </figure>
      <div class="work-info">
        <section class="work-author" aria-labelledby="work-author-name">
          <a class="work-author-link" data-work-booth href={firstHall.boothPath}>
            {designer.store.avatar && <span class:list={['bo-avatar', { 'bo-avatar-contain': designer.store.avatarFit === 'contain' }]}><img src={designer.store.avatar} alt="" decoding="async" /></span>}
            <div><span class="work-author-category">{firstHall.authorLabel}</span><h2 class="work-author-name" id="work-author-name">{designer.name}</h2></div>
          </a>
          {designer.store.description && <p class="work-author-bio">{designer.store.description}</p>}
        </section>
        <div class="work-actions">
          <a class="btn btn-primary" data-work-booth href={firstHall.boothPath}>逛他的攤位 →</a>
          <button class="btn" type="button" data-share-work={firstHall.sharePath} data-work-designer={designer.name} data-work-image={work.cover} data-work-label={label} aria-haspopup="dialog" aria-controls="work-share-dialog">分享這件作品</button>
        </div>
        {work.url && <a class="work-source" href={work.url} target="_blank" rel="noopener noreferrer">查看原始連結 ↗</a>}
        <div class="work-more"><a class="work-market-link" href={firstHall.marketPath}>繼續逛市集 →</a></div>
      </div>
    </article>
  </main>
  <footer class="work-footer">
    <small>© 2026 發光的地方｜收錄之作品與商標，其權利歸各設計師或原權利人所有。</small>
    <PrivacyLink compact />
  </footer>
  {!Astro.props.shareHall && <script define:vars={{ halls }}>
    const hallCode = new URLSearchParams(location.search).get('hall');
    const hall = halls.find(entry => entry.code === hallCode);
    if (hall) {
      document.title = hall.pageTitle;
      const schema = document.querySelector('script[type="application/ld+json"]');
      const page = JSON.parse(schema.textContent);
      page.name = hall.pageTitle;
      schema.textContent = JSON.stringify(page);
      for (const link of document.querySelectorAll('[data-work-booth]')) link.href = hall.boothPath;
      const breadcrumb = document.querySelector('[data-work-hall]');
      breadcrumb.href = hall.marketPath;
      breadcrumb.textContent = hall.name;
      document.querySelector('.work-author-category').textContent = hall.authorLabel;
      document.querySelector('.work-market-link').href = hall.marketPath;
      document.querySelector('[data-share-work]').dataset.shareWork = hall.sharePath;
    }
  </script>}
  <WorkShareDialog />
</body>
</html>
