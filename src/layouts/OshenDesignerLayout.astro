---
import { designers, designerRoot, designerPath } from '../lib/oshen-designers';
import { boothHtml } from '../../public/designers/js/ui/booth-markup.js';
import { designerMetadata, designerStructuredData, serializeStructuredData } from '../../public/designers/js/profile-seo.js';
import { hallPageForCode } from '../../public/designers/js/hall-pages.js';
import { designerSharePath } from '../../public/designers/js/routes.js';
import WorkShareDialog from '../components/WorkShareDialog.astro';
import PrivacyLink from '../components/PrivacyLink.astro';
interface Props { designerId?: string; hallCode?: string; shareHall?: string }
const designer = designers.find(profile => profile.id === Astro.props.designerId);
const shareHall = designer && Astro.props.shareHall;
const shareBooth = shareHall && designer?.booth.hallBooths.find(booth => booth.aisle[0] === shareHall);
const hall = hallPageForCode(Astro.props.hallCode || shareHall || designer?.hallCode) || hallPageForCode('O')!;
const listedDesigners = designer ? [] : designers.filter(profile => profile.hallCodes.includes(hall.code));
const metadata = designer && designerMetadata(designer.store);
const title = metadata ? metadata.title : hall.title;
const shareTitle = metadata ? metadata.shareTitle : title;
const description = metadata ? metadata.description : hall.description;
const canonical = new URL(designer ? designerPath(designer.id) : hall.path, Astro.site).href;
const shareUrl = designer && shareHall ? new URL(designerSharePath(designer.id, shareHall), Astro.site).href : canonical;
const structuredData = designer && designerStructuredData(designer.store, designer.booth, canonical, new URL(designerRoot, Astro.site).href);
const exhibitionImage = new URL('/designers/assets/exhibition-og.webp?v=20261123-webp', Astro.site).href;
const preview = designer ? designer.og : hall;
const shareImage = new URL(designer?.og?.url || preview?.image || exhibitionImage, Astro.site).href;
const shareImageAlt = preview?.alt || '洋流設計師展逛攤畫面';
---
<!doctype html>
<html lang="zh-Hant-TW" data-designer-profile={designer?.id}>
<head>
<meta charset="utf-8">
<script is:inline defer src="/assets/analytics.js?v=20261019-content-group"></script>
<script is:inline>
  if (!document.documentElement.hasAttribute('data-designer-profile')) {
    document.documentElement.classList.add('designer-booting');
  }
</script>
<style is:global>
  #stage-loading { display: none; min-height: 0; flex-direction: column; align-items: center; justify-content: center; gap: 16px; background: var(--paper-2); text-align: center; }
  #stage-loading img { display: block; width: min(600px, calc(100% - 32px)); height: auto; max-height: calc(100svh - 150px); object-fit: contain; }
  #stage-loading p { margin: 0; color: var(--green-deep); font-weight: 700; }
  #stage-loading .designer-loading-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  html.designer-booting #stage-loading { display: flex; }
  html.designer-booting #stage-walk,
  html.designer-booting #stage-list,
  html.designer-booting #stage-map { display: none !important; }
</style>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#f82970">
<link rel="icon" href="data:,">
{description && <meta name="description" content={description}>}
<meta property="og:type" content="website">
<meta property="og:url" content={shareUrl}>
<meta property="og:site_name" content="發光的地方">
<meta property="og:locale" content="zh_TW">
<meta property="og:title" content={shareTitle}>
{description && <meta property="og:description" content={description}>}
<meta property="og:image" content={shareImage}>
<meta property="og:image:alt" content={shareImageAlt}>
<meta property="og:image:type" content={preview?.type || 'image/webp'}>
<meta property="og:image:width" content={preview?.width || 2622}>
<meta property="og:image:height" content={preview?.height || 1206}>
<meta name="twitter:card" content={designer ? 'summary' : 'summary_large_image'}>
<meta name="twitter:title" content={shareTitle}>
{description && <meta name="twitter:description" content={description}>}
<meta name="twitter:image" content={shareImage}>
<meta name="twitter:image:alt" content={shareImageAlt}>
{structuredData && <script is:inline id="designer-structured-data" type="application/ld+json" set:html={serializeStructuredData(structuredData)} />}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=IBM+Plex+Mono:wght@500;600&display=swap">
<link rel="stylesheet" href="/designers/css/market.css">
<link rel="stylesheet" href="/designers/css/booth.css?v=20261123-webp">
<link rel="stylesheet" href="/designers/css/work.css?v=20261114-share-channels">
<link rel="stylesheet" href="/designers/css/map.css?v=20261114-bluebird-hall">
<link rel="stylesheet" href="/designers/css/list.css?v=20261124-hall-seo">
<link rel="stylesheet" href="/designers/css/closed.css">
<link rel="stylesheet" href="/designers/css/floating-nav.css?v=20261124-designer-menu">
</head>
<body>
<div class="app designer-app">
  <a class="btn designer-home" href="/designers/">上一頁</a>
  <details class="floating-nav" id="floating-nav">
    <summary class="floating-nav-toggle" aria-label="導覽選單"><span aria-hidden="true">☰</span> 選單</summary>
    <nav class="bar" aria-label="導覽選單">
    <a class="plaque" href={hall.path} aria-label="發光的設計師">
      <span>發光的設計師</span>
    </a>
    <div class="modes" role="group" aria-label="逛法">
      <button type="button" data-mode="walk" aria-pressed="true">逛場子</button>
      <button type="button" data-mode="list" aria-pressed="false">設計師列表</button>
      <button type="button" data-mode="map" aria-pressed="false">設計師地圖</button>
    </div>
    <span class="tag close-tag" id="close-tag" hidden></span>
    <a class="link-btn" href="/stage/">發光的舞台</a>
    <PrivacyLink class="link-btn" />
    <a class="link-btn" href="/privacy/#copyright">版權資訊</a>
    </nav>
  </details>

  <main id="stage-loading" aria-label="載入市集">
    {!designer && <img src="/designers/assets/loading-market-v1.webp?v=a8357891a028f24f" width="960" height="640" alt="" fetchpriority="high" decoding="async" />}
    <p id="designer-loading-message" class="designer-loading-sr" role="status">設計師市集，載入中，馬上來</p>
    <button id="designer-loading-retry" type="button" class="btn" hidden>重新載入</button>
  </main>
  <main class="stage" id="stage-walk" hidden>
    <canvas id="walk-canvas" tabindex="0" aria-label="逛場子畫面：按住拖著小人走，點設計師即可查看介紹"></canvas>
    <button type="button" class="where" id="btn-where"><b id="where-hall">{hall.name}</b><span id="where-aisle"></span><span class="where-switch">換館</span></button>
    <div class="status"><span class="tag tag-zone" id="status-zone"></span><span class="tag" id="status-count"></span></div>
    <p class="hint" id="hint">按住畫面拖著小人走，點一下就走過去，點設計師查看介紹，點路人或對話框可收聲。電腦可以用方向鍵。</p>
    <div class="dock">
      <button type="button" class="btn btn-primary" id="btn-browse" disabled>靠近即可認識設計師</button>
      <button type="button" class="btn" id="btn-next">下一攤</button>
      <button type="button" class="btn" id="btn-find-designer" aria-controls="stage-list">找設計師</button>
    </div>
  </main>

  <main class="list-mode" id="stage-list" tabindex="-1">
    <div class="ls-wrap">
      {designer ? (
        <article id="static-designer-profile" aria-label={designer.name} set:html={boothHtml(shareBooth ? { ...designer.booth, id: shareBooth.id } : designer.booth, designer.store, { profile: true, staticProfile: true })} />
      ) : (
        <>
          <h1 class="ls-title">{hall.heading || hall.name}</h1>
          <p class="ls-intro">{hall.description}</p>
          {!listedDesigners.length && <p>{hall.name}目前尚無攤位。</p>}
          <div class="ls-grid">
            {listedDesigners.map(profile => (
              <article class="lc">
                <div class="lc-heading"><h2 class="lc-name"><a class="lc-open" href={designerPath(profile.id)}>{profile.name}</a></h2></div>
                <p class="lc-owner">{profile.store.category} {profile.name}</p>
                <p class="lc-zone">{hall.name}・{profile.store.category}</p>
                <a class="btn btn-primary lc-go" href={designerPath(profile.id)}>{profile.works.length ? '看作品' : '看介紹'}</a>
              </article>
            ))}
          </div>
        </>
      )}
    </div>
  </main>
  <main class="map-mode" id="stage-map" hidden></main>
  <div class="toast" id="toast" role="status" popover="manual"></div>
</div>

<dialog id="dlg-booth" class="dlg" aria-labelledby="booth-title"></dialog>
<WorkShareDialog kind="designer" />
<WorkShareDialog />
<script is:inline type="module" src="/designers/js/app.js?v=20261124-profile-boot"></script>
</body>
</html>
