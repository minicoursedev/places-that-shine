---
interface Props {
  target: string;
  title: string;
}

const { target, title } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <script is:inline define:vars={{ target }}>
      const destination = new URL(target + location.search, location.origin);
      if (location.hash) {
        import('/designers/js/legacy-entry.js?v=20261126-vote-hall').then(({ legacyDesignerDestination }) => {
          const hall = target === '/designers/halls/amateurs/' ? 'A' : 'O';
          location.replace(legacyDesignerDestination(new URL(location.href), hall) || destination);
        });
      } else {
        location.replace(destination);
      }
    </script>
    <noscript><meta http-equiv="refresh" content={`0;url=${target}`} /></noscript>
  </head>
  <body>
    <a href={target}>{title}</a>
  </body>
</html>
